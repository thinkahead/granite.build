# granite-5.1-20b-sft-preview-r261020a (MoE, 56 experts top-4, no shared expert, ~22B total).
# Tokenizer and chat template are already the 4.2 ones. The -eager dir symlinks the HF snapshot
# and sets _experts_implementation: eager (the default grouped_mm stalled at step 0, build 5bc7d970).
MODEL_URI=env:///proj/granite-build/g4os/models/granite-5.1-20b-sft-preview-r261020a-eager
EXPERIMENT=sft_g51_20b_v2_odm_90_10_entropy_xml
PER_DEVICE_TRAIN_BATCH_SIZE=4
# Full checkpoints (weights + optimizer + scheduler + RNG + ODM state) so a run can resume
# (MAX_RETRIES resumes from the latest). Model-only would be ~82 GB but not resumable, which
# blocked resuming build 1e20c15f to turn on reward batching (2026-10-29). 10 checkpoints at the
# full size are a few TB of the ~18 TB free on /proj/granite-build.
SAVE_ONLY_MODEL=false
# Batched ODM reward pass (tuning-slurm src/odm_batched_reward.py): 2.9x faster on this model in
# the 2-GPU FSDP test, rewards within ~2e-4 of batch 1. One eval/ODM update every 500 steps
# instead of 250: ~70 min per update at batch 1 made evals ~23 h of build 1e20c15f's ~30 h.
ODM_REWARD_BATCH_SIZE=8
EVAL_STEPS=500
ODM_UPDATE_INTERVAL=500
# gpu-high: not preemptible, so model-only checkpoints are safe. Max 2 days (~12-15 h needed).
QUEUE=gpu-high
QOS=grp_granite_dot_build_high_1n
TIME_LIMIT=2-00:00:00
# Host RAM (GB). The 256 GB default was OOM-killed in data preparation (build 91ee9c05): 8 ranks
# each hold the 44 GB model while 96 tokenizer workers fork. gpu-high nodes have 2 TB.
MEMORY=1600
# 2 gpu-high nodes (16 x H200; quota is 24 GPUs since 2026-10-29). Global batch 64 instead of 32,
# so 2500 steps cover the same 160k sequences as 5000 steps on 1 node.
NUM_NODES=2
MAX_STEPS=2500
SAVE_STEPS=500
# A retry restarts from the base model rather than resuming from this run's checkpoints.
RESUME_FROM_CHECKPOINT=false
