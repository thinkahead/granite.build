# granite-5.1-20b-sft-preview-r261020a (MoE, 56 experts top-4, no shared expert, ~22B total).
# Tokenizer and chat template are already the 4.2 ones. The -eager dir symlinks the HF snapshot
# and sets _experts_implementation: eager (the default grouped_mm stalled at step 0, build 5bc7d970).
MODEL_URI=env:///proj/granite-build/g4os/models/granite-5.1-20b-sft-preview-r261020a-eager
EXPERIMENT=sft_g51_20b_v2_odm_90_10_entropy_xml
PER_DEVICE_TRAIN_BATCH_SIZE=4
# A full checkpoint with optimizer state is ~220 GB; model-only ~44 GB (not resumable).
SAVE_ONLY_MODEL=true
# gpu-high: not preemptible, so model-only checkpoints are safe. Max 2 days (~12-15 h needed).
QUEUE=gpu-high
QOS=grp_granite_dot_build_high_1n
TIME_LIMIT=2-00:00:00
# Host RAM (GB). The 256 GB default was OOM-killed in data preparation (build 91ee9c05): 8 ranks
# each hold the 44 GB model while 96 tokenizer workers fork. gpu-high nodes have 2 TB.
MEMORY=1600
